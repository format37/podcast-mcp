# podcast MCP configuration. Copy to .env; .env is gitignored.
# Only ELEVENLABS_API_KEY is required — everything else has a working default.

# ---------------------------------------------------------------------------
# ElevenLabs
# ---------------------------------------------------------------------------
ELEVENLABS_API_KEY=
MODEL_ID=eleven_v3
# Only eleven_v3 supports text-to-dialogue. Note that request stitching
# (previous_request_ids) is NOT available for v3 and the dialogue endpoint has
# no such field at all, so block seams cannot be conditioned — see chunker.py.

# Default hosts. Premade multilingual voices work for en/ru/ja alike.
# Avoid Professional Voice Clones with v3. List options with podcast_voices.
VOICE_A_ID=cgSgspJ2msm6clMCkdW9   # Jessica — playful, bright
VOICE_B_ID=cjVigY5qzO86Huf0OWal   # Eric — smooth, trustworthy
# Optional per-language pairs, overriding the two above:
# VOICE_MAP=ru:voiceIdA|voiceIdB,ja:voiceIdA|voiceIdB

# 0.0 = most expressive/variable, 1.0 = most consistent.
ELEVENLABS_STABILITY=0.5

# ---------------------------------------------------------------------------
# Script limits and chunking
# ---------------------------------------------------------------------------
MAX_SCRIPT_CHARS=30000
MAX_TURN_CHARS=500
# HARD CEILING 2000: the documented per-request limit, summed across
# inputs[].text. 1800 leaves margin for overhead.
BLOCK_CHAR_LIMIT=1800
# A block_break_after marker is only honoured once a block has this many chars,
# so a script that marks every turn does not render one API call per turn.
MIN_BLOCK_CHARS=600

# ---------------------------------------------------------------------------
# Render loop
# ---------------------------------------------------------------------------
MAX_BLOCK_ATTEMPTS=3
RATE_LIMIT_MAX_WAIT_S=300

# Speech rate per language, in characters of script per second of audio.
# MEASURED on real v3 renders — and it MUST stay per-language: Japanese runs at
# 5.6 c/s against English's 14.1, so one global window would reject every
# correct Japanese block, retry it at full cost, and fail the job.
LANG_CPS=en:14.1,ru:13.2,ja:5.6
# Fallback rate for a language not listed above.
ESTIMATE_CPS=14.1
# The duration sanity window is derived from each language's own rate, so
# adding a language means adding one number to LANG_CPS. Wide on purpose: this
# catches truncation and silence, it is not a quality gate.
SANITY_LOW_FACTOR=0.42
SANITY_HIGH_FACTOR=2.2
# Window for an unmeasured language, where the true rate is unknown.
SANITY_UNKNOWN_MIN_CPS=2
SANITY_UNKNOWN_MAX_CPS=35

# Measured, not documented by ElevenLabs.
CREDITS_PER_CHAR=0.55

# ---------------------------------------------------------------------------
# Mixing
# ---------------------------------------------------------------------------
CONCAT_MODE=crossfade      # crossfade | pad
CROSSFADE_MS=60
PAD_SILENCE_MS=100
LOUDNORM_I=-16             # podcast standard LUFS
LOUDNORM_TP=-1.5
MP3_BITRATE=96k            # mono 96k ~= 0.69 MB/min, so 25 min stays under
MP3_CHANNELS=1             # Telegram's 20 MB send-by-URL limit
# Optional jingles, mixed in at JINGLE_GAIN_DB relative to speech.
# INTRO_PATH=/app/data/intro.mp3
# OUTRO_PATH=/app/data/outro.mp3
JINGLE_GAIN_DB=-6

# ---------------------------------------------------------------------------
# Storage and show identity
# ---------------------------------------------------------------------------
OUTPUT_DIR=/app/data/episodes
KEEP_BLOCKS=true           # per-block mp3s: the only way to debug a seam later
EPISODE_MAX_AGE_DAYS=0     # 0 = never prune
SHOW_TITLE=Podcast         # sendAudio performer + ID3 artist
# SHOW_IMAGE=/app/data/cover.jpg   # sendAudio thumbnail + ID3 cover

# ---------------------------------------------------------------------------
# Telegram delivery (optional)
# ---------------------------------------------------------------------------
# When configured AND auto-send is on, a finished episode is uploaded to the
# chat with sendAudio as soon as it renders. All three can also be set from the
# console's settings page, which stores them in data/settings.json (chmod 600);
# setting the token here instead keeps the secret off disk entirely.
# The stored value wins if both are present.
# TELEGRAM_BOT_TOKEN=      # from @BotFather
# TELEGRAM_CHAT_ID=        # negative id for a group/channel; bot must be a member
# TELEGRAM_AUTO_SEND=false

# ---------------------------------------------------------------------------
# Server / auth (VPS deployment only; leave empty for localhost)
# ---------------------------------------------------------------------------
# MCP_TOKENS=comma,separated,secrets
# MCP_REQUIRE_AUTH=true
# MCP_ALLOWED_HOSTS=scriptlab.duckdns.org
# MCP_PUBLIC_BASE_URL=https://scriptlab.duckdns.org
# Separate secret guarding BOTH the episode download route (which Telegram must
# reach without an Authorization header) and the private web console. When set,
# the console lives at /podcast/<DOWNLOAD_TOKEN>/console and the unprefixed
# path 404s. Deliberately not MCP_TOKENS: sharing a console or episode URL must
# never hand over the credential that can drive the server.
#   generate with:  openssl rand -hex 24
# DOWNLOAD_TOKEN=
